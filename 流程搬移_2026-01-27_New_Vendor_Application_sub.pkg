                "SParam5": null,
                "Express": "List\u003CUser\u003E users = new List\u003CUser\u003E();\r\nstring[] accs = Convert.ToString(\u0022test\u0022).Split(\u0027,\u0027);\r\nforeach(string acc in accs)\r\n{\r\n    User user = Context.OrgService.GetUser(acc);\r\n    if (!users.Contains(user))\r\n        users.Add(user);\r\n}\r\nreturn users;\r\n",
