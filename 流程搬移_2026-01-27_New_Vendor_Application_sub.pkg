          {
            "Name": "SQL",
            "NodeId": "node_ext-31269",
            "Sprite": "{\u0022translationX\u0022:467.81494140625,\u0022translationY\u0022:250.370361328125,\u0022x\u0022:0,\u0022y\u0022:0,\u0022width\u0022:32,\u0022height\u0022:32,\u0022lineWidth\u0022:1,\u0022lineDash\u0022:[],\u0022strokeStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022fillStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022sprites\u0022:{\u0022text\u0022:{\u0022text\u0022:\u0022SQL\u0022,\u0022fillStyle\u0022:\u0022#000000\u0022,\u0022fontFamily\u0022:\u0022sans-serif\u0022,\u0022fontSize\u0022:\u002212px\u0022,\u0022fontWeight\u0022:\u0022\u0022,\u0022fontStyle\u0022:\u0022\u0022,\u0022underline\u0022:false,\u0022background\u0022:{\u0022fillStyle\u0022:\u0022none\u0022}}},\u0022xclass\u0022:\u0022ZHYSoft.bpm.src.flowchart.sprite.SQLPlugin\u0022,\u0022surfaceName\u0022:\u0022shape\u0022}",
            "propertyXClass": "ZHYSoft.bpm.src.flowchart.property.SQLPlugin",
            "ElementTypeName": "SQLPluginNode",
            "Rules": [],
            "Events": [],
            "NodeExtAttrs": [],
            "DataSourceName": "763108719505477",
            "CommandText": "-- \u66F4\u65B0 1: \u5EFA\u7ACB Vendor_Form_Link \u95DC\u806F\uFF08\u4F7F\u7528 TaskID\uFF09\nUPDATE S\nSET S.Vendor_Form_Link = M.TaskID  -- \u6539\u70BA\u5B58 TaskID\nFROM BDS_New_Vendor_Application_Sub AS S\nINNER JOIN BDS_New_Vendor_Application AS M\n    ON  M.Vendor_Name = S.Vendor_Name \n    AND M.Tax = S.Tax \n    AND M.Email = S.Email \n    AND M.Vendor_Type = S.Vendor_Type\nWHERE M.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Vendor_Form_Link\u0022]%\u003E\u0027\n  AND S.Vendor_Form_Link IS NULL;\n\n-- \u66F4\u65B0 2: \u66F4\u65B0\u4E3B\u8868\u7684\u5730\u5740\u8CC7\u8A0A\nUPDATE M\nSET \n    M.Country = S.Country,\n    M.City = S.City,\n    M.Postal_Code = S.Postal_Code,\n    M.Street = S.Street,\n    M.Country_ID = S.Country_ID,\n    M.City_ID = S.City_ID\nFROM BDS_New_Vendor_Application AS M\nINNER JOIN BDS_New_Vendor_Application_Sub AS S \n    ON M.Vendor_Name = S.Vendor_Name \n    AND M.Tax = S.Tax \n    AND M.Email = S.Email \n    AND M.Vendor_Type = S.Vendor_Type\nWHERE M.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Vendor_Form_Link\u0022]%\u003E\u0027;\n\n-- \u66F4\u65B0 3: \u4F7F\u7528 ROW_NUMBER \u6309\u9806\u5E8F\u5339\u914D\uFF08\u6700\u7D42\u4FEE\u6B63\u7248\uFF09\nUPDATE S\nSET \n    S.Transaction_Details_Company = EntityRN.Company,\n    S.Transaction_Details_Region = EntityRN.Region,\n    S.Transaction_Details_Site = EntityRN.Site\nFROM BDS_New_Vendor_Application_Sub AS S\nINNER JOIN (\n    SELECT \n        S.ItemId AS SubItemId,\n        S.Vendor_Form_Link,\n        ROW_NUMBER() OVER (PARTITION BY S.Vendor_Form_Link ORDER BY S.ItemId) AS RowNum\n    FROM BDS_New_Vendor_Application_Sub S\n    WHERE S.Vendor_Form_Link IS NOT NULL\n) SubRN ON S.ItemId = SubRN.SubItemId\n-- \u900F\u904E TaskID \u627E\u5230 Main \u8868\nINNER JOIN BDS_New_Vendor_Application AS M\n    ON M.TaskID = SubRN.Vendor_Form_Link  -- \u7528 TaskID \u5339\u914D\nINNER JOIN (\n    SELECT \n        T.ParentItemId,\n        T.Company,\n        T.Region,\n        T.Site,\n        ROW_NUMBER() OVER (PARTITION BY T.ParentItemId ORDER BY T.OrderIndex, T.ItemId) AS RowNum\n    FROM BDS_New_Vendor_Application_Transaction_Entity T\n    WHERE T.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Vendor_Form_Link\u0022]%\u003E\u0027\n      AND T.ParentItemId IS NOT NULL\n) EntityRN ON M.ItemId = EntityRN.ParentItemId  -- Main.ItemId \u5C0D\u61C9 Entity.ParentItemId\n           AND SubRN.RowNum = EntityRN.RowNum    -- \u6309\u9806\u5E8F\u5339\u914D\nWHERE S.Vendor_Form_Link IS NOT NULL;\n\n-- \u66F4\u65B0 4: \u66F4\u65B0 Role \u548C RoleID\nUPDATE S\nSET \n    S.SupplyChainRole = \u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site,\n    S.SupplyChainRoleID = R1.Id,\n    S.ACCTRole = \u0027ACCT_\u0027 \u002B S.Transaction_Details_Site,\n    S.ACCTRoleID = R2.Id,\n    S.TOMRole = \u0027TOM_\u0027 \u002B S.Transaction_Details_Site,\n    S.TOMRoleID = R3.Id,\n    S.SPECRole = \u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site,\n    S.SPECRoleID = R4.Id\nFROM BDS_New_Vendor_Application_Sub AS S\nLEFT JOIN [FZBPM].[dbo].[bpm_org_role] AS R1\n    ON R1.RoleName = (\u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [FZBPM].[dbo].[bpm_org_role] AS R2\n    ON R2.RoleName = (\u0027ACCT_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [FZBPM].[dbo].[bpm_org_role] AS R3\n    ON R3.RoleName = (\u0027TOM_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [FZBPM].[dbo].[bpm_org_role] AS R4\n    ON R4.RoleName = (\u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nWHERE S.Vendor_Form_Link IS NOT NULL\n  AND S.Transaction_Details_Site IS NOT NULL;"
          },
          {
