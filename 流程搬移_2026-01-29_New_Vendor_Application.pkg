                "SParam4": null,
                "SParam5": null,
                "Express": "List\u003CUser\u003E users = new List\u003CUser\u003E();\nint num = 1; \nforeach(WFDataRow row in FormDataSet.Tables[\u0022Transaction_Entity\u0022].Rows)\n{    \n     string account = \u0022IT00\u0022 \u002B num.ToString();\n     User findUser=OrgService.GetUser(account);\n     if(!users.Contains(findUser))\n          users.Add(findUser);\n      num \u002B= 1; \n}\nreturn users;",
                "Include": true,
                "Exclude": false,
                "IsValid": true,
                "DisplayString": "FormDataSet[\u0022Transaction_Entity.HandleAccount\u0022]",
