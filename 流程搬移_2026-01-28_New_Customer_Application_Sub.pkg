          {
            "Name": "SQL",
            "NodeId": "node_ext-31269",
            "Sprite": "{\u0022translationX\u0022:447.81494140625,\u0022translationY\u0022:230.370361328125,\u0022x\u0022:0,\u0022y\u0022:0,\u0022width\u0022:32,\u0022height\u0022:32,\u0022lineWidth\u0022:1,\u0022lineDash\u0022:[],\u0022strokeStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022fillStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022sprites\u0022:{\u0022text\u0022:{\u0022text\u0022:\u0022SQL\u0022,\u0022fillStyle\u0022:\u0022#000000\u0022,\u0022fontFamily\u0022:\u0022sans-serif\u0022,\u0022fontSize\u0022:\u002212px\u0022,\u0022fontWeight\u0022:\u0022\u0022,\u0022fontStyle\u0022:\u0022\u0022,\u0022underline\u0022:false,\u0022background\u0022:{\u0022fillStyle\u0022:\u0022none\u0022}}},\u0022xclass\u0022:\u0022ZHYSoft.bpm.src.flowchart.sprite.SQLPlugin\u0022,\u0022surfaceName\u0022:\u0022shape\u0022}",
            "propertyXClass": "ZHYSoft.bpm.src.flowchart.property.SQLPlugin",
            "ElementTypeName": "SQLPluginNode",
            "Rules": [],
            "Events": [],
            "NodeExtAttrs": [],
            "DataSourceName": "763108719505477",
            "CommandText": "-- \u66F4\u65B0 1: \u5C07 Sub.TaskID \u5BEB\u5165 Entity.Detail\nUPDATE Entity\nSET Entity.Detail = CAST(SubRN.SubTaskID AS NVARCHAR(100))\nFROM BDS_New_Customer_Application_Transaction_Entity AS Entity\nINNER JOIN (\n    SELECT \n        Entity.ItemId AS EntityItemId,\n        Entity.ParentItemId,\n        ROW_NUMBER() OVER (PARTITION BY Entity.ParentItemId ORDER BY Entity.ItemId) AS RowNum\n    FROM BDS_New_Customer_Application_Transaction_Entity Entity\n    WHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n      AND Entity.ParentItemId IS NOT NULL\n) EntityRN ON Entity.ItemId = EntityRN.EntityItemId\nINNER JOIN BDS_New_Customer_Application T2 \n    ON T2.ItemId = EntityRN.ParentItemId\nINNER JOIN (\n    SELECT \n        Sub.TaskID AS SubTaskID,\n        Sub.ParentFormNO,\n        ROW_NUMBER() OVER (PARTITION BY Sub.ParentFormNO ORDER BY Sub.TaskID) AS RowNum\n    FROM BDS_New_Customer_Application_Sub Sub\n) SubRN ON SubRN.ParentFormNO = T2.FormNO \n        AND EntityRN.RowNum = SubRN.RowNum\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL;\n\n-- \u66F4\u65B0 2: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Company = Entity.Company\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Company IS NOT NULL;\n\n-- \u66F4\u65B0 3: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Site = Entity.Site\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Site IS NOT NULL;\n\n-- \u66F4\u65B0 4: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Region = Entity.Region\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Region IS NOT NULL;\n"
          },
