            "Participants": [
              {
                "ParticipantType": 3,
                "LParam1": 5,
                "LParam2": 0,
                "SParam1": "\u003C%=FormDataSet[\u0022$$root.ParentInitiator\u0022]%\u003E",
                "SParam2": null,
                "SParam3": null,
                "SParam4": null,
                "SParam5": null,
                "Express": "List\u003CUser\u003E users = new List\u003CUser\u003E();\r\nstring[] accs = Convert.ToString(FormDataSet[\u0022$$root.ParentInitiator\u0022].ToString()).Split(\u0027,\u0027);\r\nforeach(string acc in accs)\r\n{\r\n    User user = Context.OrgService.GetUser(acc);\r\n    if (!users.Contains(user))\r\n        users.Add(user);\r\n}\r\nreturn users;\r\n",
                "Include": true,
                "Exclude": false,
                "IsValid": true,
                "DisplayString": "FormDataSet[\u0022$$root.ParentInitiator\u0022]",
