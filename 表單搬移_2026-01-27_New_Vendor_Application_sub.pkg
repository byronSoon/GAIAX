        "Src": "Ext.define(\u0027ZHYSoft.form.NewForm\u0027, {\n    extend: \u0027ZHYSoft.form.AbstractForm\u0027,\n    bodyPadding: 20,\n    funcs: { //\u81EA\u5B9A\u4E49\u8BA1\u7B97\u51FD\u6570\n\u00A0 \u00A0 \u00A0 \u00A0 //\u8BA1\u7B97\u51FD\u6570\u540D: function(a, b){\n\u00A0 \u00A0 \u00A0 \u00A0 //\u00A0 \u00A0 return a*b\u002B1;\n\u00A0 \u00A0 \u00A0 \u00A0 //}\n        RoleName:function(a,b){\n             return a\u002B\u0022_\u0022\u002Bb;\n        }\n\u00A0 \u00A0 },\n    validators: { //\u81EA\u5B9A\u4E49\u9A8C\u8BC1\u51FD\u6570\n        //\u9A8C\u8BC1\u51FD\u6570\u540D: function(value, field){\n        //    if (value \u003E= 100)\n        //        return true; //\u9A8C\u8BC1\u901A\u8FC7\n        //    \n        //    return \u0027\u9519\u8BEF\u4FE1\u606F\u0027;\n        //}\n    },\n    definition: {\n        \u0022components\u0022: {\n            \u0022desc1\u0022: {\n                \u0022ctype\u0022: \u0022desc\u0022,\n                \u0022fieldBackgroundColor\u0022: \u0022#fffdf7\u0022,\n                \u0022$html\u0022: \u0022\u003Cdiv style=\\\u0022color: rgb(0, 0, 0); font-family: \u0026quot;Open Sans\u0026quot;, \u0026quot;Helvetica Neue\u0026quot;, helvetica, arial, verdana, sans-serif; font-size: 13px; text-align: center;\\\u0022\u003E\u003Cfont face=\\\u0022Open Sans, Helvetica Neue, helvetica, arial, verdana, sans-serif\\\u0022 size=\\\u00225\\\u0022\u003E\u003Cb\u003ENew Vendor Application\u003C/b\u003E\u003C/font\u003E\u003C/div\u003E\u003Cdiv style=\\\u0022text-align: center;\\\u0022\u003E\u003Cfont face=\\\u0022Open Sans, Helvetica Neue, helvetica, arial, verdana, sans-serif\\\u0022 size=\\\u00225\\\u0022 style=\\\u0022\\\u0022\u003E\u003Cb\u003ETransaction \u0026amp;\u0026nbsp;\u003C/b\u003E\u003C/font\u003E\u003Cfont face=\\\u0022Open Sans, Helvetica Neue, helvetica, arial, verdana, sans-serif\\\u0022 size=\\\u00225\\\u0022\u003E\u003Cb\u003EAccounting\u003C/b\u003E\u003C/font\u003E\u003Cb style=\\\u0022font-family: \u0026quot;Ope