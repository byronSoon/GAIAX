          {
            "Name": "SQL",
            "NodeId": "node_ext-31269",
            "Sprite": "{\u0022translationX\u0022:447.81494140625,\u0022translationY\u0022:230.370361328125,\u0022x\u0022:0,\u0022y\u0022:0,\u0022width\u0022:32,\u0022height\u0022:32,\u0022lineWidth\u0022:1,\u0022lineDash\u0022:[],\u0022strokeStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022fillStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022sprites\u0022:{\u0022text\u0022:{\u0022text\u0022:\u0022SQL\u0022,\u0022fillStyle\u0022:\u0022#000000\u0022,\u0022fontFamily\u0022:\u0022sans-serif\u0022,\u0022fontSize\u0022:\u002212px\u0022,\u0022fontWeight\u0022:\u0022\u0022,\u0022fontStyle\u0022:\u0022\u0022,\u0022underline\u0022:false,\u0022background\u0022:{\u0022fillStyle\u0022:\u0022none\u0022}}},\u0022xclass\u0022:\u0022ZHYSoft.bpm.src.flowchart.sprite.SQLPlugin\u0022,\u0022surfaceName\u0022:\u0022shape\u0022}",
            "propertyXClass": "ZHYSoft.bpm.src.flowchart.property.SQLPlugin",
            "ElementTypeName": "SQLPluginNode",
            "Rules": [],
            "Events": [],
            "NodeExtAttrs": [],
            "DataSourceName": "763108719505477",
            "CommandText": "-- \u66F4\u65B0 1: \u5C07 Sub.TaskID \u5BEB\u5165 Entity.Detail\nUPDATE Entity\nSET Entity.Detail = CAST(SubRN.SubTaskID AS NVARCHAR(100))\nFROM BDS_New_Customer_Application_Transaction_Entity AS Entity\nINNER JOIN (\n    SELECT \n        Entity.ItemId AS EntityItemId,\n        Entity.ParentItemId,\n        ROW_NUMBER() OVER (PARTITION BY Entity.ParentItemId ORDER BY Entity.ItemId) AS RowNum\n    FROM BDS_New_Customer_Application_Transaction_Entity Entity\n    WHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n      AND Entity.ParentItemId IS NOT NULL\n) EntityRN ON Entity.ItemId = EntityRN.EntityItemId\nINNER JOIN BDS_New_Customer_Application T2 \n    ON T2.ItemId = EntityRN.ParentItemId\nINNER JOIN (\n    SELECT \n        Sub.TaskID AS SubTaskID,\n        Sub.ParentFormNO,\n        ROW_NUMBER() OVER (PARTITION BY Sub.ParentFormNO ORDER BY Sub.TaskID) AS RowNum\n    FROM BDS_New_Customer_Application_Sub Sub\n) SubRN ON SubRN.ParentFormNO = T2.FormNO \n        AND EntityRN.RowNum = SubRN.RowNum\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL;\n\n-- \u2705 \u66F4\u65B0 2-1: \u76F4\u63A5\u5F9E\u4E3B\u8868\u8907\u88FD Country\nUPDATE Sub \nSET Sub.Country = T2.Country \nFROM BDS_New_Customer_Application_Sub AS Sub \nINNER JOIN BDS_New_Customer_Application AS T2 \n    ON Sub.Customer_Form_Link = T2.TaskID  -- \u7528 Customer_Form_Link \u95DC\u806F\u4E3B\u8868\nWHERE T2.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027;\n\n-- \u2705 \u66F4\u65B0 2-2: \u76F4\u63A5\u5F9E\u4E3B\u8868\u8907\u88FD City\nUPDATE Sub \nSET Sub.City = T2.City \nFROM BDS_New_Customer_Application_Sub AS Sub \nINNER JOIN BDS_New_Customer_Application AS T2 \n    ON Sub.Customer_Form_Link = T2.TaskID  -- \u7528 Customer_Form_Link \u95DC\u806F\u4E3B\u8868\nWHERE T2.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027;\n\n-- \u66F4\u65B0 2: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Company = Entity.Company\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Company IS NOT NULL;\n\n-- \u66F4\u65B0 3: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Site = Entity.Site\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Site IS NOT NULL;\n\n-- \u66F4\u65B0 4: \u7528 Sub.TaskID \u914D\u5C0D\nUPDATE Sub\nSET Sub.Transaction_Entity_Region = Entity.Region\nFROM BDS_New_Customer_Application_Sub AS Sub\nINNER JOIN BDS_New_Customer_Application_Transaction_Entity AS Entity\n    ON Sub.TaskID = CAST(Entity.Detail AS BIGINT)  -- \u2705 \u6539\u7528 TaskID \u914D\u5C0D\nWHERE Entity.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND Entity.ParentItemId IS NOT NULL\n  AND Entity.Detail IS NOT NULL\n  AND Entity.Region IS NOT NULL;\n\n-- \u66F4\u65B0 5: \u66F4\u65B0 Role \u548C RoleID\nUPDATE S\nSET \n    S.CGSRole = \u0027CGS_\u0027 \u002B S.Transaction_Entity_Site,\n    S.CGSRoleID = R1.Id,\n    S.ACCTRole = \u0027ACCT_\u0027 \u002B S.Transaction_Entity_Site,\n    S.ACCTRoleID = R2.Id,\n    S.TOMRole = \u0027TOM_\u0027 \u002B S.Transaction_Entity_Site,\n    S.TOMRoleID = R3.Id\nFROM BDS_New_Customer_Application_Sub AS S\nLEFT JOIN [dbo].[bpm_org_role] AS R1\n    ON R1.RoleName = (\u0027CGS_\u0027 \u002B S.Transaction_Entity_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [dbo].[bpm_org_role] AS R2\n    ON R2.RoleName = (\u0027ACCT_\u0027 \u002B S.Transaction_Entity_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [dbo].[bpm_org_role] AS R3\n    ON R3.RoleName = (\u0027TOM_\u0027 \u002B S.Transaction_Entity_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nWHERE S.Customer_Form_Link IS NOT NULL\n  AND S.Transaction_Entity_Site IS NOT NULL;\n \n-- \u66F4\u65B0 6: \u900F\u904E Company \u5F9E BDS_Relatinship \u5E36\u51FA Credit_Limit_Currency (\u53D6\u7B2C\u4E00\u7B46)\nUPDATE S\nSET S.Credit_Limit_Currency = R.Currency\nFROM BDS_New_Customer_Application_Sub AS S\nOUTER APPLY (\n    SELECT TOP 1 Rel.Currency\n    FROM BDS_Relatinship AS Rel\n    WHERE Rel.Company_Code = S.Transaction_Entity_Company\n    -- \u5982\u679C\u6709\u7279\u5B9A\u6392\u5E8F\u9700\u6C42\uFF08\u4F8B\u5982\u62FF\u6700\u65B0\u7684\u4E00\u7B46\uFF09\uFF0C\u53EF\u4EE5\u5728\u9019\u88E1\u52A0 ORDER BY\n) R\nWHERE S.Customer_Form_Link = \u0027\u003C%=FormDataSet[\u0022$$root.Customer_Form_Link\u0022]%\u003E\u0027\n  AND S.Transaction_Entity_Company IS NOT NULL;\n"
          },
          {
