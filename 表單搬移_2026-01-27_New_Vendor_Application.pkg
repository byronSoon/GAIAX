        "Src": "Ext.define(\u0027ZHYSoft.form.NewForm\u0027, {\n    extend: \u0027ZHYSoft.form.AbstractForm\u0027,\n    bodyPadding: 20,\n    funcs: { //\u81EA\u5B9A\u4E49\u8BA1\u7B97\u51FD\u6570\n        //\u8BA1\u7B97\u51FD\u6570\u540D: function(a, b){\n        //    return a*b\u002B1;\n        //}\n    },\n    validators: { //\u81EA\u5B9A\u4E49\u9A8C\u8BC1\u51FD\u6570\n        //\u9A8C\u8BC1\u51FD\u6570\u540D: function(value, field){\n        //    if (value \u003E= 100)\n        //        return true; //\u9A8C\u8BC1\u901A\u8FC7\n        //    \n        //    return \u0027\u9519\u8BEF\u4FE1\u606F\u0027;\n        //}\n    },\n    definition: {\n        \u0022components\u0022: {\n            \u0022desc1\u0022: {\n                \u0022ctype\u0022: \u0022desc\u0022,\n                \u0022fieldBackgroundColor\u0022: \u0022#fffdf7\u0022,\n                \u0022$html\u0022: \u0022\u003Cdiv style=\\\u0022text-align: center;\\\u0022\u003E\u003Cfont face=\\\u0022Open Sans, Helvetica Neue, helvetica, arial, verdana, sans-serif\\\u0022 size=\\\u00225\\\u0022\u003E\u003Cb\u003ENew Vendor Application\u003C/b\u003E\u003C/font\u003E\u003C/div\u003E\u0022,\n                \u0022uniqueId\u0022: \u0022cd2fa053-a71e-4e8c-8bb8-f6d0a58ed1cf\u0022\n            },\n            \u0022segmentbar1\u0022: {\n                \u0022ctype\u0022: \u0022segmentbar\u0022,\n                \u0022title\u0022: \u0022Applicant Information\u0022,\n                \u0022uniqueId\u0022: \u002271f5ff32-c184-40ce-b2af-9ae2a5e00336\u0022\n            },\n            \u0022sn1\u0022: {\n                \u0022ctype\u0022: \u0022sn\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022FormNO\u0022,\n                \u0022$bind\u0022: \u0022FormNO\u0022,\n                \u0022uniqueId\u0022: \u00228bd9b3e5-c856-45bc-854b-5d23e8ba109a\u0022\n            },\n            \u0022tablecell1\u0022: {\n                \u0022$items\u0022: [\n                    \u0022sn1\u0022\n                ]\n            },\n            \u0022initiator1\u0022: {\n                \u0022ctype\u0022: \u0022initiator\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Initiator\u0022,\n                \u0022$bind\u0022: \u0022Initiator\u0022,\n                \u0022uniqueId\u0022: \u002265faf693-0eba-4595-bb35-82b68252e740\u0022\n            },\n            \u0022tablecell2\u0022: {\n                \u0022$items\u0022: [\n                    \u0022initiator1\u0022\n                ]\n            },\n            \u0022starttime1\u0022: {\n                \u0022ctype\u0022: \u0022starttime\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Start Time\u0022,\n                \u0022$bind\u0022: \u0022Start_Time\u0022,\n                \u0022uniqueId\u0022: \u00222bba5c3b-c438-44a1-a0e3-93ba703aed41\u0022\n            },\n            \u0022tablecell3\u0022: {\n                \u0022$items\u0022: [\n                    \u0022starttime1\u0022\n                ]\n            },\n            \u0022owner1\u0022: {\n                \u0022ctype\u0022: \u0022owner\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Owner\u0022,\n                \u0022$bind\u0022: \u0022Owner\u0022,\n                \u0022uniqueId\u0022: \u0022b83b114a-8981-44b0-a25a-305f3b25eb8a\u0022\n            },\n            \u0022tablecell4\u0022: {\n                \u0022$items\u0022: [\n                    \u0022owner1\u0022\n                ]\n            },\n            \u0022dept1\u0022: {\n                \u0022ctype\u0022: \u0022dept\u0022,\n                \u0022fieldLabel\u0022: \u0022Dept\u0022,\n                \u0022showFullPath\u0022: false,\n                \u0022persistence\u0022: true,\n                \u0022$bind\u0022: \u0022Dept\u0022,\n                \u0022uniqueId\u0022: \u0022f5ce3195-a430-41f5-a0ab-b915df6f7435\u0