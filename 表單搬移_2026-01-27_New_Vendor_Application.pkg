layField\u0022: \u0022Vendor_Type_Name\u0022,\n                \u0022$bind\u0022: \u0022Vendor_Type\u0022,\n                \u0022uniqueId\u0022: \u00227d042435-a93c-4193-8d1f-88fadfb71382\u0022\n            },\n            \u0022tablecell7\u0022: {\n                \u0022$items\u0022: [\n                    \u0022combobox1\u0022\n                ],\n                \u0022colspan\u0022: 2\n            },\n            \u0022combobox2\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Communication Language\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763339852169285\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Language\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u0022b92e3ab6-e992-436c-8b7c-80ecab8bf0eb\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u0022f0801023-2e0d-474e-938d-76d5d975224f\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u0022b70ffc28-89a1-41d9-b142-3d060be5f8b1\u0022\n                    }\n                ],\n                \u0022allowBlank\u0022: false,\n                \u0022valueField\u0022: \u0022Language_Key\u0022,\n                \u0022displayField\u0022: \u0022Name_of_Language\u0022,\n                \u0022$bind\u0022: \u0022Communication_Language\u0022,\n                \u0022uniqueId\u0022: \u0022d500af4e-b2b8-4d03-b0cf-bbcb398c2b76\u0022\n            },\n            \u0022tablecell9\u0022: {\n                \u0022$items\u0022: [\n                    \u0022combobox2\u0022\n                ],\n                \u0022colspan\u0022: 2\n            },\n            \u0022textarea1\u0022: {\n                \u0022ctype\u0022: \u0022textarea\u0022,\n                \u0022maxLength\u0022: 500,\n                \u0022fieldLabel\u0022: \u0022Vendor Name\u0022,\n                \u0022grow\u0022: true,\n                \u0022growMin\u0022: 31,\n                \u0022growMax\u0022: 171,\n                \u0022allowBlank\u0022: false,\n                \u0022$bind\u0022: \u0022Vendor_Name\u0022,\n                \u0022uniqueId\u0022: \u0022869963b9-8218-4b32-8fd3-a340687b08fe\u0022\n            },\n            \u0022tablecell11\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022textarea1\u0022\n                ]\n            },\n            \u0022combobox4\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Tax Number Type\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763354526916677\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Tax_Number_Type\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n                },\n                \u0022options\u0022: [\n              