        \u0022fieldLabel\u0022: \u0022FSC Certificate No.\u0022,\n                \u0022lockBinding\u0022: true,\n                \u0022$bind\u0022: \u0022FSC_Certificate_No\u0022,\n                \u0022uniqueId\u0022: \u0022bb5adf71-485d-48a1-a10c-375ff7a3787d\u0022\n            },\n            \u0022tablecell15\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022text1\u0022\n                ]\n            },\n            \u0022tablecell17\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: []\n            },\n            \u0022desc3\u0022: {\n                \u0022ctype\u0022: \u0022desc\u0022,\n                \u0022fieldBackgroundColor\u0022: \u0022#fffdf7\u0022,\n                \u0022$html\u0022: \u0022Main Address\u0022,\n                \u0022uniqueId\u0022: \u00229203efb4-4bdb-4310-be7f-36c56a1a0854\u0022\n            },\n            \u0022tablecell13\u0022: {\n                \u0022$items\u0022: [\n                    \u0022desc3\u0022\n                ]\n            },\n            \u0022tablecell20\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022tablecell16\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022tablecell18\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022combobox5\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Country\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763354541809733\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Country\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n 