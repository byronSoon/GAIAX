          {
            "Name": "SQL",
            "NodeId": "node_ext-31269",
            "Sprite": "{\u0022translationX\u0022:467.81494140625,\u0022translationY\u0022:250.370361328125,\u0022x\u0022:0,\u0022y\u0022:0,\u0022width\u0022:32,\u0022height\u0022:32,\u0022lineWidth\u0022:1,\u0022lineDash\u0022:[],\u0022strokeStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022fillStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022sprites\u0022:{\u0022text\u0022:{\u0022text\u0022:\u0022SQL\u0022,\u0022fillStyle\u0022:\u0022#000000\u0022,\u0022fontFamily\u0022:\u0022sans-serif\u0022,\u0022fontSize\u0022:\u002212px\u0022,\u0022fontWeight\u0022:\u0022\u0022,\u0022fontStyle\u0022:\u0022\u0022,\u0022underline\u0022:false,\u0022background\u0022:{\u0022fillStyle\u0022:\u0022none\u0022}}},\u0022xclass\u0022:\u0022ZHYSoft.bpm.src.flowchart.sprite.SQLPlugin\u0022,\u0022surfaceName\u0022:\u0022shape\u0022}",
            "propertyXClass": "ZHYSoft.bpm.src.flowchart.property.SQLPlugin",
            "ElementTypeName": "SQLPluginNode",
            "Rules": [],
            "Events": [],
            "NodeExtAttrs": [],
            "DataSourceName": "763108719505477",
            "CommandText": "\n-- \u66F4\u65B0 3: \u4F7F\u7528 ROW_NUMBER \u6309\u9806\u5E8F\u5339\u914D\uFF08\u5F37\u5316\u7248\uFF0C\u5305\u542B Region \u66F4\u65B0\uFF09\nUPDATE S\nSET \n    S.Transaction_Details_Company = EntityRN.Company,\n    S.Transaction_Details_Region = EntityRN.Region,      -- \u78BA\u4FDD\u9019\u884C\u6709\u57F7\u884C\n    S.Transaction_Details_Site = EntityRN.Site,\n    S.Transaction_Details_Region_ID = EntityRN.Region_ID -- \u5EFA\u8B70\u540C\u6B65\u66F4\u65B0 ID \u6B04\u4F4D\nFROM BDS_New_Vendor_Application_Sub AS S\nINNER JOIN (\n    SELECT \n        S.ItemId AS SubItemId,\n        S.Vendor_Form_Link,\n        ROW_NUMBER() OVER (PARTITION BY S.Vendor_Form_Link ORDER BY S.ItemId) AS RowNum\n    FROM BDS_New_Vendor_Application_Sub S\n    WHERE S.Vendor_Form_Link IS NOT NULL\n) SubRN ON S.ItemId = SubRN.SubItemId\nINNER JOIN BDS_New_Vendor_Application AS M\n    ON M.TaskID = SubRN.Vendor_Form_Link  \nINNER JOIN (\n    SELECT \n        T.ParentItemId,\n        T.Company,\n        T.Region,\n        T.Region_ID,  -- \u589E\u52A0 Region_ID \u6293\u53D6\n        T.Site,\n        ROW_NUMBER() OVER (PARTITION BY T.ParentItemId ORDER BY T.OrderIndex, T.ItemId) AS RowNum\n    FROM BDS_New_Vendor_Application_Transaction_Entity T\n    WHERE T.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Vendor_Form_Link\u0022]%\u003E\u0027\n      AND T.ParentItemId IS NOT NULL\n) EntityRN ON M.ItemId = EntityRN.ParentItemId  \n           AND SubRN.RowNum = EntityRN.RowNum    \nWHERE S.Vendor_Form_Link IS NOT NULL;\n\n-- \u66F4\u65B0 4: \u66F4\u65B0 Role \u548C RoleID\nUPDATE S\nSET \n    S.SupplyChainRole = \u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site,\n    S.SupplyChainRoleID = R1.Id,\n    S.ACCTRole = \u0027ACCT_\u0027 \u002B S.Transaction_Details_Site,\n    S.ACCTRoleID = R2.Id,\n    S.TOMRole = \u0027TOM_\u0027 \u002B S.Transaction_Details_Site,\n    S.TOMRoleID = R3.Id,\n    S.SPECRole = \u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site,\n    S.SPECRoleID = R4.Id\nFROM BDS_New_Vendor_Application_Sub AS S\nLEFT JOIN [dbo].[bpm_org_role] AS R1\n    ON R1.RoleName = (\u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [dbo].[bpm_org_role] AS R2\n    ON R2.RoleName = (\u0027ACCT_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [dbo].[bpm_org_role] AS R3\n    ON R3.RoleName = (\u0027TOM_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nLEFT JOIN [dbo].[bpm_org_role] AS R4\n    ON R4.RoleName = (\u0027SupplyChain_\u0027 \u002B S.Transaction_Details_Site) COLLATE SQL_Latin1_General_CP1_CI_AS\nWHERE S.Vendor_Form_Link IS NOT NULL\n  AND S.Transaction_Details_Site IS NOT NULL;\n  \n-- \u66F4\u65B0 5: \u5C07\u5B50\u8868\u7684 TaskID \u5BEB\u5165\u5BE6\u9AD4\u8868\u7684 Detail \u6B04\u4F4D\nUPDATE E\nSET \n    E.Detail = CAST(S.TaskID AS NVARCHAR(100))\nFROM BDS_New_Vendor_Application_Transaction_Entity AS E\n-- 1. \u900F\u904E ParentItemId \u627E\u5230\u4E3B\u8868 (Main)\nINNER JOIN BDS_New_Vendor_Application AS M \n    ON E.ParentItemId = M.ItemId\n-- 2. \u900F\u904E\u4E3B\u8868\u7684 TaskID \u627E\u5230\u5B50\u8868 (Sub) \u7684 Vendor_Form_Link\nINNER JOIN BDS_New_Vendor_Application_Sub AS S \n    ON S.Vendor_Form_Link = M.TaskID \n-- 3. \u5339\u914D\u7AD9\u9EDE\u8CC7\u8A0A (Site) \u8207 \u516C\u53F8\u8CC7\u8A0A (Company) \u78BA\u4FDD\u884C\u5C0D\u884C\n    AND RTRIM(LTRIM(S.Transaction_Details_Site)) = RTRIM(LTRIM(E.Site))\n    AND RTRIM(LTRIM(S.Transaction_Details_Company)) = RTRIM(LTRIM(E.Company))\n-- 4. \u95DC\u9375\u904E\u6FFE\uFF1A\u78BA\u4FDD\u53EA\u66F4\u65B0\u7576\u524D\u8868\u55AE\u76F8\u95DC\u7684\u5BE6\u9AD4\u8CC7\u6599\nWHERE M.TaskID = \u0027\u003C%=FormDataSet[\u0022$$root.Vendor_Form_Link\u0022]%\u003E\u0027;\n\n"
          },
          {
            "Name": "Applicant fills in information",
            "NodeId": "node_ext-31270",
            "Sprite": "{\u0022translationX\u0022:611.8889770507812,\u0022translationY\u0022:250,\u0022x\u0022:0,\u0022y\u0022:0,\u0022width\u0022:32,\u0022height\u0022:32,\u0022lineWidth\u0022:1,\u0022lineDash\u0022:[],\u0022strokeStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022fillStyle\u0022:\u0022rgba(0, 0, 0, 0)\u0022,\u0022sprites\u0022:{\u0022text\u0022:{\u0022text\u0022:\u0022Applicant fills in information\u0022,\u0022fillStyle\u0022:\u0022#000000\u0022,\u0022fontFamily\u0022:\u0022sans-serif\u0022,\u0022fontSize\u0022:\u002212px\u0022,\u0022fontWeight\u0022:\u0022\u0022,\u0022fontStyle\u0022:\u0022\u0022,\u0022underline\u0022:false,\u0022background\u0022:{\u0022fillStyle\u0022:\u0022none\u0022}}},\u0022xclass\u0022:\u0022ZHYSoft.bpm.src.flowchart.sprite.Activity\u0022,\u0022surfaceName\u0022:\u0022shape\u0022}",
