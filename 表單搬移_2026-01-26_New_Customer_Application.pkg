        "Src": "Ext.define(\u0027ZHYSoft.form.NewForm\u0027, {\n    extend: \u0027ZHYSoft.form.AbstractForm\u0027,\n    bodyPadding: 20,\n    funcs: { //\u81EA\u5B9A\u4E49\u8BA1\u7B97\u51FD\u6570\n        //\u8BA1\u7B97\u51FD\u6570\u540D: function(a, b){\n        //    return a*b\u002B1;\n        //}\n    },\n    validators: { //\u81EA\u5B9A\u4E49\u9A8C\u8BC1\u51FD\u6570\n        //\u9A8C\u8BC1\u51FD\u6570\u540D: function(value, field){\n        //    if (value \u003E= 100)\n        //        return true; //\u9A8C\u8BC1\u901A\u8FC7\n        //    \n        //    return \u0027\u9519\u8BEF\u4FE1\u606F\u0027;\n        //}\n    },\n    definition: {\n        \u0022components\u0022: {\n            \u0022desc1\u0022: {\n                \u0022ctype\u0022: \u0022desc\u0022,\n                \u0022fieldBackgroundColor\u0022: \u0022#fffdf7\u0022,\n                \u0022$html\u0022: \u0022\u003Cdiv style=\\\u0022text-align: center;\\\u0022\u003E\u003Cb style=\\\u0022\\\u0022\u003E\u003Cfont size=\\\u00225\\\u0022\u003ENew Customer Application\u003C/font\u003E\u003C/b\u003E\u003C/div\u003E\u0022,\n                \u0022uniqueId\u0022: \u0022cd2fa053-a71e-4e8c-8bb8-f6d0a58ed1cf\u0022\n            },\n            \u0022segmentbar1\u0022: {\n                \u0022ctype\u0022: \u0022segmentbar\u0022,\n                \u0022title\u0022: \u0022Applicant Information\u0022,\n                \u0022uniqueId\u0022: \u002271f5ff32-c184-40ce-b2af-9ae2a5e00336\u0022\n            },\n            \u0022sn1\u0022: {\n                \u0022ctype\u0022: \u0022sn\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022FormNO\u0022,\n                \u0022$bind\u0022: \u0022FormNO\u0022,\n                \u0022uniqueId\u0022: \u00228bd9b3e5-c856-45bc-854b-5d23e8ba109a\u0022\n            },\n            \u0022tablecell1\u0022: {\n                \u0022$items\u0022: [\n                    \u0022sn1\u0022\n                ]\n            },\n            \u0022initiator1\u0022: {\n                \u0022ctype\u0022: \u0022initiator\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Initiator\u0022,\n                \u0022$bind\u0022: \u0022Initiator\u0022,\n                \u0022uniqueId\u0022: \u002265faf693-0eba-4595-bb35-82b68252e740\u0022\n            },\n            \u0022tablecell2\u0022: {\n                \u0022$items\u0022: [\n                    \u0022initiator1\u0022\n                ]\n            },\n            \u0022starttime1\u0022: {\n                \u0022ctype\u0022: \u0022starttime\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Start Time\u0022,\n                \u0022$bind\u0022: \u0022Start_Time\u0022,\n                \u0022uniqueId\u0022: \u00222bba5c3b-c438-44a1-a0e3-93ba703aed41\u0022\n            },\n            \u0022tablecell3\u0022: {\n                \u0022$items\u0022: [\n                    \u0022starttime1\u0022\n                ]\n            },\n            \u0022owner1\u0022: {\n                \u0022ctype\u0022: \u0022owner\u0022,\n                \u0022persistence\u0022: true,\n                \u0022fieldLabel\u0022: \u0022Owner\u0022,\n                \u0022$bind\u0022: \u0022Owner\u0022,\n                \u0022uniqueId\u0022: \u0022b83b114a-8981-44b0-a25a-305f3b25eb8a\u0022\n            },\n            \u0022tablecell4\u0022: {\n                \u0022$items\u0022: [\n                    \u0022owner1\u0022\n                ]\n            },\n            \u0022dept1\u0022: {\n                \u0022ctype\u0022: \u0022dept\u0022,\n                \u0022fieldLabel\u0022: \u0022Dept\u0022,\n                \u0022showFullPath\u0022: false,\n                \u0022persistence\u0022: true,\n                \u0022$bind\u0022: \u0022Dept\u0022,\n                \u0022uniqueId\u0022: \u0022f5ce3195-a430-41f5-a0ab-b915df6f7435\u0022\n            },\n            \u0022tablecell5\u0022: {\n                \u0022$items\u0022: [\n                    \u0022dept1\u0022\n                ]\n            },\n            \u0022tablecell6\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022table1\u0022: {\n                \u0022ctype\u0022: \u0022table\u0022,\n                \u0022columns\u0022: 3,\n                \u0022cellVerticalAlign\u0022: \u0022middle\u0022,\n                \u0022$items\u0022: [\n                    \u0022tablecell1\u0022,\n                    \u0022tablecell2\u0022,\n                    \u0022tablecell3\u0022,\n                    \u0022tablecell4\u0022,\n                    \u0022tablecell5\u0022,\n                    \u0022tablecell6\u0022\n                ]\n            },\n            \u0022segmentbar2\u0022: {\n                \u0022ctype\u0022: \u0022segmentbar\u0022,\n                \u0022title\u0022: \u0022Basic Info\u0022,\n                \u0022uniqueId\u0022: \u002205f4954d-d31c-442d-860b-9a15402ec6c8\u0022\n            },\n            \u0022attachment1\u0022: {\n                \u0022ctype\u0022: \u0022attachment\u0022,\n                \u0022maxLength\u0022: 200,\n                \u0022fieldLabel\u0022: \u0022Attachments\u0022,\n                \u0022maxNum\u0022: 0,\n                \u0022fileTypes\u0022: \u0022*.*\u0022,\n                \u0022typesDesc\u0022: \u0022\u6240\u6709\u6A94\u0022,\n                \u0022fileSizeLimit\u0022: \u002210MB\u0022,\n                \u0022lockBinding\u0022: true,\n                \u0022$bind\u0022: \u0022Attachments\u0022,\n                \u0022uniqueId\u0022: \u0022e6b86db0-265b-42d0-9480-e540ae00ae74\u0022\n            },\n            \u0022text1\u0022: {\n                \u0022ctype\u0022: \u0022text\u0022,\n                \u0022fieldLabel\u0022: \u0022SAP Customer Number\u0022,\n                \u0022emptyText\u0022: \u0022\u6700\u5F8C\u95DC\u5361\u78BA\u8A8D\u5B8C\u5F8C\u56DE\u586BSAP\u5BA2\u6236\u7DE8\u865F\u0022,\n                \u0022$disable\u0022: \u0022$activityName!=\\\u0022BT\\\u0022\u0022,\n                \u0022validators\u0022: [\n                    {\n                        \u0022type\u0022: \u0022required\u0022,\n                        \u0022$disable\u0022: \u0022$activityName!=\\\u0022BT\\\u0022\u0022\n                    }\n                ],\n                \u0022$bind\u0022: \u0022SAP_Customer_Number\u0022,\n                \u0022uniqueId\u0022: \u0022693e9fea-3cac-46a1-8490-99aaa6829ecd\u0022\n            },\n            \u0022tablecell45\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022text1\u0022\n                ]\n            },\n            \u0022tablecell51\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022tablecell52\u0022: {\n                \u0022$items\u0022: []\n            },\n            \u0022combobox1\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Customer Type\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763339840618565\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Customer_Type\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u00221a855cf5-7e40-4614-97cf-f079229a1f5d\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u0022abf9347c-0b33-4a8d-8fcc-5c21ad22bd23\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u00227395d800-f39c-4b10-b32b-0d8bb8b7a943\u0022\n                    }\n                ],\n                \u0022allowBlank\u0022: false,\n                \u0022valueField\u0022: \u0022Customer_Type_Name\u0022,\n                \u0022displayField\u0022: \u0022Customer_Type_Name\u0022,\n                \u0022$map\u0022: {\n                    \u0022Customer_Type_ID\u0022: \u0022Customer_Type_ID\u0022,\n                    \u0022Customer_Type_Name\u0022: \u0022Customer_Type_Name_ID\u0022\n                },\n                \u0022selectFirstOne\u0022: true,\n                \u0022$bind\u0022: \u0022Customer_Type\u0022,\n                \u0022uniqueId\u0022: \u00227d042435-a93c-4193-8d1f-88fadfb71382\u0022\n            },\n            \u0022text7\u0022: {\n                \u0022ctype\u0022: \u0022text\u0022,\n                \u0022fieldLabel\u0022: \u0022Customer Type_ID\u0022,\n                \u0022$hidden\u0022: \u00221\u0022,\n                \u0022$bind\u0022: \u0022Customer_Type_ID\u0022,\n                \u0022uniqueId\u0022: \u00222c02566c-4cc6-4de7-ae28-39abff2cd394\u0022\n            },\n            \u0022tablecell7\u0022: {\n                \u0022$items\u0022: [\n                    \u0022combobox1\u0022,\n                    \u0022text7\u0022\n                ],\n                \u0022colspan\u0022: 2\n            },\n            \u0022combobox2\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Communication Language\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763339852169285\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Language\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u0022b92e3ab6-e992-436c-8b7c-80ecab8bf0eb\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u0022f0801023-2e0d-474e-938d-76d5d975224f\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u0022b70ffc28-89a1-41d9-b142-3d060be5f8b1\u0022\n                    }\n                ],\n                \u0022allowBlank\u0022: false,\n                \u0022valueField\u0022: \u0022Language_Key\u0022,\n                \u0022displayField\u0022: \u0022Name_of_Language\u0022,\n                \u0022$bind\u0022: \u0022Communication_Language\u0022,\n                \u0022uniqueId\u0022: \u0022d500af4e-b2b8-4d03-b0cf-bbcb398c2b76\u0022\n            },\n            \u0022tablecell9\u0022: {\n                \u0022$items\u0022: [\n                    \u0022combobox2\u0022\n                ],\n                \u0022colspan\u0022: 2\n            },\n            \u0022textarea1\u0022: {\n                \u0022ctype\u0022: \u0022textarea\u0022,\n                \u0022maxLength\u0022: 500,\n                \u0022fieldLabel\u0022: \u0022Customer Name\u0022,\n                \u0022grow\u0022: true,\n                \u0022growMin\u0022: 31,\n                \u0022growMax\u0022: 171,\n                \u0022allowBlank\u0022: false,\n                \u0022$bind\u0022: \u0022Customer_Name\u0022,\n                \u0022uniqueId\u0022: \u0022869963b9-8218-4b32-8fd3-a340687b08fe\u0022\n            },\n            \u0022tablecell8\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022textarea1\u0022\n                ]\n            },\n            \u0022combobox12\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Parent Group\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763355584319557\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Business_Partner\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {\n                        \u0022\u5206\u7D44\u0022: {\n                            \u0022op\u0022: \u0022=\u0022,\n                            \u0022field\u0022: \u0022Customer_Type_ID\u0022\n                        }\n                    }\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u0022bc8e1546-62de-4c6b-a9f1-bce8a27e30c1\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u00229d2f9343-d0a9-4a5d-9b32-f98b1d3e29a7\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u00228305822f-5821-4493-b73a-8acbeff1a726\u0022\n                    }\n                ],\n                \u0022valueField\u0022: \u0022ItemId\u0022,\n                \u0022displayField\u0022: \u0022\u540D\u7A31_1\u0022,\n                \u0022$map\u0022: {\n                    \u0022\u540D\u7A31_1\u0022: \u0022Parent_Group_ID\u0022\n                },\n                \u0022itemsSearch\u0022: true,\n                \u0022$bind\u0022: \u0022Parent_Group\u0022,\n                \u0022uniqueId\u0022: \u00222049f6cf-e672-4cfd-a79c-8ebe8512c803\u0022\n            },\n            \u0022text5\u0022: {\n                \u0022ctype\u0022: \u0022text\u0022,\n                \u0022fieldLabel\u0022: \u0022Parent Group_ID\u0022,\n                \u0022$hidden\u0022: \u00221\u0022,\n                \u0022$bind\u0022: \u0022Parent_Group_ID\u0022,\n                \u0022uniqueId\u0022: \u00225773937a-4e72-46e1-8c57-6f94bdee8c2b\u0022\n            },\n            \u0022tablecell22\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022combobox12\u0022,\n                    \u0022text5\u0022\n                ]\n            },\n            \u0022combobox3\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Business Model\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763355578900549\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Business_Model\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {}\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u002202d8dde4-8dc4-460e-acc0-ee17525a2d88\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u0022f2535e12-6f71-460f-8f8b-69c55cea526a\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u0022c1114d9d-bcdc-4080-8468-c8508abb0ad2\u0022\n                    }\n                ],\n                \u0022allowBlank\u0022: false,\n                \u0022valueField\u0022: \u0022Business_Model_ID\u0022,\n                \u0022displayField\u0022: \u0022Business_Model_Name\u0022,\n                \u0022$map\u0022: {\n                    \u0022Business_Model_Name\u0022: \u0022Business_Model_Name\u0022\n                },\n                \u0022$bind\u0022: \u0022Business_Model\u0022,\n                \u0022uniqueId\u0022: \u0022e2841a3d-3b45-4d02-98ab-66f2a0b5bc6c\u0022\n            },\n            \u0022text9\u0022: {\n                \u0022ctype\u0022: \u0022text\u0022,\n                \u0022fieldLabel\u0022: \u0022Business_Model_Name\u0022,\n                \u0022$hidden\u0022: \u00221\u0022,\n                \u0022$bind\u0022: \u0022Business_Model_Name\u0022,\n                \u0022uniqueId\u0022: \u00223ecd1c53-7a22-4645-846c-c92b0350f3d1\u0022\n            },\n            \u0022tablecell11\u0022: {\n                \u0022colspan\u0022: 2,\n                \u0022$items\u0022: [\n                    \u0022combobox3\u0022,\n                    \u0022text9\u0022\n                ]\n            },\n            \u0022combobox19\u0022: {\n                \u0022ctype\u0022: \u0022combobox\u0022,\n                \u0022fieldLabel\u0022: \u0022Brand Customer\u0022,\n                \u0022emptyText\u0022: \u0022--\u8ACB\u9078\u64C7--\u0022,\n                \u0022use\u0022: \u0022ds\u0022,\n                \u0022ds\u0022: {\n                    \u0022type\u0022: \u0022form\u0022,\n                    \u0022formId\u0022: \u0022763355584319557\u0022,\n                    \u0022formTable\u0022: \u0022BDS_Business_Partner\u0022,\n                    \u0022orderBy\u0022: \u0022\u0022,\n                    \u0022filter\u0022: {\n                        \u0022\u5206\u7D44\u0022: {\n                            \u0022op\u0022: \u0022=\u0022,\n                            \u0022field\u0022: \u0022Customer_Type_ID\u0022\n                        }\n                    }\n                },\n                \u0022options\u0022: [\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 1\u0022,\n                        \u0022value\u0022: \u00221\u0022,\n                        \u0022checked\u0022: true,\n                        \u0022uniqueId\u0022: \u00222c682956-ecd7-4508-920b-77091369281f\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 2\u0022,\n                        \u0022value\u0022: \u00222\u0022,\n                        \u0022uniqueId\u0022: \u00220571adc1-bad5-4adb-bdb7-a344c405d9c7\u0022\n                    },\n                    {\n                        \u0022text\u0022: \u0022\u9078\u9805 3\u0022,\n                        \u0022value\u0022: \u00223\u0022,\n                        \u0022uniqueId\u0022: \u002248806469-97a3-412d-8611-466b8